# Server runtime
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Multiple client origins can be comma-separated, e.g. https://campusbook.example,https://admin.example
ENABLE_DOCS=false

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/campusbook

# JWT (required; set a unique random secret of at least 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google Identity Services ID-token audience
GOOGLE_CLIENT_ID=

# Cloudinary image storage (optional in local development; leave blank to use placeholders)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo HTTP API (recommended for Render to prevent outbound SMTP port blocking)
BREVO_API_KEY=

# SMTP server hostname (e.g. smtp.gmail.com or smtp.mailtrap.io; used when BREVO_API_KEY is not set)
EMAIL_HOST=

# SMTP port (465 for SSL, 587 for TLS/STARTTLS)
EMAIL_PORT=

# SMTP username or email address
EMAIL_USER=

# SMTP password or Google App Password (16 characters without spaces)
EMAIL_PASS=

# Sender email display format (e.g. "CampusBook <no-reply@yourdomain.com>")
EMAIL_FROM=

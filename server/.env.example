# Server runtime
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Multiple client origins can be comma-separated, e.g. https://campusbook.example,https://admin.example

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/campusbook

# JWT (required; set a unique random secret of at least 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary image storage (optional in local development; leave blank to use placeholders)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP email delivery (required in production; leave all values blank for development console dispatch)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

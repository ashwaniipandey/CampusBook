{
  "name": "campusbook-server",
  "version": "1.0.0",
  "description": "CampusBook Express Backend REST API and Socket.io server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "seed": "node src/seeds/seed.js",
    "seed:reviews": "node src/scripts/seedReviews.js",
    "make-admin": "node src/scripts/setAdmin.js",
    "fix:prices": "node src/scripts/fixBookPrices.js",
    "migrate:verification": "node src/scripts/migrateVerification.js",
    "migrate:emailverified": "node src/scripts/migrateEmailVerified.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{js,json}\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.6.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.2",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^9.21.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "supertest": "^7.3.1"
  }
}
